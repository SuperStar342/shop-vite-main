# 开发环境，VUE_APP_BASE_URL可以选择自己配置成需要的接口地址，如"https://api.xxx.com"
# 此文件修改后需要重启项目

# NODE_ENV禁止修改
NODE_ENV=development

# api接口地址
# 保留 /api：原生 /blade-system/* 会拼成 /api/blade-system/*；参考项目 API 已自带 /api 前缀不会重复拼接
VITE_APP_BASE_URL=/api

VITE_OAUTH_CLIENT_ID=saber3
VITE_OAUTH_CLIENT_SECRET=saber3_secret
